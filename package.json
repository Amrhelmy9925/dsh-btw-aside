{
  "name": "@local/dsh-btw-aside",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Amr Ahmed Helmy",
  "description": "Ask a side question in the right sidebar without touching the main conversation.",
  "keywords": ["dsh-plugin", "dsh-bundle", "sidebar", "aside", "side-question"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
